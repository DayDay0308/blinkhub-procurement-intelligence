# Copy to .env and change values. Never commit .env.
POSTGRES_USER=blinkhub
POSTGRES_PASSWORD=blinkhub
# Host port for PostgreSQL (Power BI connects here). Use e.g. 5440 if a local PostgreSQL already uses 5432.
DB_PORT=5432
# Host port for the web app
WEB_PORT=8080
ENVIRONMENT=local
# At least 32 characters. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=local-dev-secret-change-me-0123456789
SEED_ON_START=true
# Also generate a synthetic demonstration year (~450 suppliers, ~R85m) with planted anomalies
SEED_SYNTHETIC=true
DEMO_PASSWORD=Demo@2026!
# Encrypts supplier bank account numbers at rest (pgcrypto)
DATA_ENCRYPTION_KEY=local-dev-data-key-change-me
# How often the worker checks invoice payment deadlines
SLA_CHECK_MINUTES=15
# Password for the read-only database login that runs Ask BlinkHub queries
ASK_DB_PASSWORD=ask-local-dev-password
# Optional AI features (certificate reading, Ask BlinkHub). Leave empty to use the
# built-in rules and saved questions. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
