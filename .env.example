# Copy to .env and change values. Never commit .env.
POSTGRES_USER=blinkhub
POSTGRES_PASSWORD=blinkhub
ENVIRONMENT=local
# At least 32 characters. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=local-dev-secret-change-me-0123456789
SEED_ON_START=true
DEMO_PASSWORD=Demo@2026!
# Encrypts supplier bank account numbers at rest (pgcrypto)
DATA_ENCRYPTION_KEY=local-dev-data-key-change-me
# How often the worker checks invoice payment deadlines
SLA_CHECK_MINUTES=15
